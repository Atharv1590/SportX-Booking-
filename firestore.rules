rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLivePulse(data) {
      return data.keys().hasAll(['channelId', 'version', 'lastEventType', 'updatedAt'])
        && data.keys().hasOnly(['channelId', 'version', 'lastEventType', 'affectedDate', 'sportId', 'updatedAt'])
        && data.channelId is string
        && data.channelId.size() >= 1
        && data.channelId.size() <= 64
        && data.channelId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.version is int
        && data.version >= 0
        && data.lastEventType is string
        && data.lastEventType.size() >= 1
        && data.lastEventType.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() >= 1
        && data.updatedAt.size() <= 64
        && (!('affectedDate' in data) || (data.affectedDate is string && data.affectedDate.size() <= 20))
        && (!('sportId' in data) || (data.sportId is string && data.sportId.size() <= 64));
    }

    // Read-only non-PII live sync channel populated exclusively by server firebase-admin
    match /live_sync/{channelId} {
      allow get: if isValidId(channelId) && (resource == null || isValidLivePulse(resource.data));
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
